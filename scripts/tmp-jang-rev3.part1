sor:pointer}.choice.correct{background:#e6f6eb!important;border-color:#39814e!important;font-weight:800}.choice.wrong{background:#fff0f0!important;border-color:#c74c4c!important}.feedback,.solution{display:none;margin-top:11px;padding:12px;border-radius:9px}.feedback.show,.solution.show{display:block}.feedback.ok{background:#e6f6eb;color:#1c6635}.feedback.no{background:#fff0f0;color:#9a2a2a}.solution{background:#f3f6f9}.answer{font-weight:900;color:#1e6538}.option-notes{margin-bottom:0;padding-left:24px}.option-notes li{margin:8px 0}.notes{font-size:15px;color:#526070}.index{display:inline-block;margin-top:12px;padding:9px 13px;border-radius:8px;background:var(--a);color:white!important;text-decoration:none!important;font-weight:900}@media(max-width:680px){.sut-lit{font-size:16px}.sut-hero{padding:20px}.sut-hero h1{font-size:25px}.source,.quiz{padding:16px}.tbl{display:block;overflow-x:auto}.sut-lit h2{font-size:21px}.flow{grid-template-columns:1fr}}
